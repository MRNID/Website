{
  "name": "packing-video-proof",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Packing & Return Proof Video System for Fulfillment Warehouses",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "node --test packages/shared-utils/dist/barcode-validator.test.js",
    "test:e2e": "node scripts/test-e2e.mjs",
    "start:backend": "pnpm --filter @packing-proof/backend-api start",
    "start:worker": "pnpm --filter @packing-proof/video-worker start",
    "start:user": "pnpm --filter @packing-proof/user-web dev",
    "start:admin": "pnpm --filter @packing-proof/admin-web dev"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0"
}

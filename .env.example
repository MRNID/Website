# Environment Template for Packing Video Proof

# SQL Server (set DB_PORT for TCP, or omit it and set DB_INSTANCE for a named instance)
DB_SERVER="localhost"
DB_PORT=1433
DB_NAME="packing_proof_db"
DB_USER="packing_app"
DB_PASSWORD=""
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Backend API Configuration
PORT=4000
HOST="0.0.0.0"
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required: startup rejects empty, short and previous demo JWT secrets.
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Google OAuth credentials: use a newly rotated secret from Google Cloud Console.
# Leave empty to keep Google Drive unavailable; the app never simulates a connection.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"
ADMIN_WEB_URL="http://localhost:3001"

# Cryptographic Master Key for Credential Encryption (AES-256-GCM - exactly 32 bytes hex)
ENCRYPTION_MASTER_KEY_32B=""

# Video Worker Configuration
STATION_CODE="PACK01"
STATION_ID=""
WORKER_TOKEN=""
BACKEND_WS_URL="ws://localhost:4000/ws/worker"
LOCAL_TEMP_DIR="D:\\PackingVideoTemp"
LOCAL_ARCHIVE_DIR="D:\\PackingVideo"
# Production warehouse: use the separate .worker.env generated by storage:provision.
JOURNAL_DIR="D:/PackingVideo/journal"

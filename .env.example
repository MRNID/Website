# Environment Template for Packing Video Proof

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:SecretPassword123!@localhost:5432/packing_proof_db?schema=public"

# Backend API Configuration
PORT=4000
HOST="0.0.0.0"
JWT_SECRET="super-secret-jwt-key-minimum-32-chars-length!"
JWT_EXPIRES_IN="8h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Cryptographic Master Key for Credential Encryption (AES-256-GCM - exactly 32 bytes hex)
ENCRYPTION_MASTER_KEY_32B="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Video Worker Configuration
STATION_CODE="PACK01"
WORKER_TOKEN="st_secret_token_pack01"
BACKEND_WS_URL="ws://localhost:4000/ws/worker"
LOCAL_TEMP_DIR="D:\\PackingVideoTemp"
LOCAL_ARCHIVE_DIR="D:\\PackingVideo"
NAS_SHARE_DIR="\\\\SERVER\\PackingVideo"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(100)
  code           String          @unique @db.VarChar(50)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  warehouses     Warehouse[]
  roles          Role[]
  users          User[]
  systemLogs     SystemLog[]

  @@map("businesses")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String    @db.VarChar(50)
  description String?   @db.VarChar(255)
  permissions Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([businessId, name], name: "uq_role_business_name")
  @@map("roles")
}

model Warehouse {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  name            String           @db.VarChar(100)
  code            String           @unique @db.VarChar(50)
  address         String?          @db.Text
  timezone        String           @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users           User[]
  stations        Station[]
  orders          Order[]
  packingSessions PackingSession[]
  storageConfigs  StorageConfig[]
  systemLogs      SystemLog[]

  @@map("warehouses")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  warehouseId     String?          @map("warehouse_id") @db.Uuid
  username        String           @unique @db.VarChar(50)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  fullName        String           @map("full_name") @db.VarChar(100)
  email           String           @unique @db.VarChar(100)
  roleId          String           @map("role_id") @db.Uuid
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  packingSessions PackingSession[]
  lockedVideos    Video[]          @relation("VideoLockedBy")
  systemLogs      SystemLog[]

  @@unique([id, warehouseId], name: "uq_user_id_warehouse")
  @@map("users")
}

model Station {
  id              String           @id @default(uuid()) @db.Uuid
  warehouseId     String           @map("warehouse_id") @db.Uuid
  name            String           @db.VarChar(100)
  code            String           @unique @db.VarChar(50)
  computerName    String?          @map("computer_name") @db.VarChar(100)
  ipAddress       String?          @map("ip_address") @db.VarChar(45)
  status          String           @default("OFFLINE") @db.VarChar(30)
  lastHeartbeatAt DateTime?        @map("last_heartbeat_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  worker          Worker?
  cameras         Camera[]
  packingSessions PackingSession[]
  packingCommands PackingCommand[]
  systemLogs      SystemLog[]

  @@unique([id, warehouseId], name: "uq_station_id_warehouse")
  @@map("stations")
}

model Worker {
  id              String               @id @default(uuid()) @db.Uuid
  stationId       String               @unique @map("station_id") @db.Uuid
  tokenHash       String               @map("token_hash") @db.VarChar(255)
  currentEpoch    String?              @map("current_epoch") @db.Uuid
  version         String               @default("1.0.0") @db.VarChar(30)
  status          String               @default("OFFLINE") @db.VarChar(30)
  ipAddress       String?              @map("ip_address") @db.VarChar(45)
  lastHeartbeatAt DateTime?            @map("last_heartbeat_at") @db.Timestamptz
  systemTelemetry Json?                @map("system_telemetry")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  station         Station              @relation(fields: [stationId], references: [id], onDelete: Cascade)
  inboxEvents     WorkerEventsInbox[]

  @@map("workers")
}

model Camera {
  id                String           @id @default(uuid()) @db.Uuid
  stationId         String           @map("station_id") @db.Uuid
  name              String           @db.VarChar(100)
  type              String           @default("RTSP") @db.VarChar(20)
  rtspUrl           String?          @map("rtsp_url") @db.Text
  username          String?          @db.VarChar(100)
  passwordEncrypted String?          @map("password_encrypted") @db.Text
  status            String           @default("OFFLINE") @db.VarChar(30)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  station           Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  packingSessions   PackingSession[]

  @@unique([id, stationId], name: "uq_camera_id_station")
  @@map("cameras")
}

model Order {
  id              String           @id @default(uuid()) @db.Uuid
  warehouseId     String           @map("warehouse_id") @db.Uuid
  orderCode       String           @map("order_code") @db.VarChar(100)
  trackingCode    String           @map("tracking_code") @db.VarChar(100)
  platform        String           @default("OTHER") @db.VarChar(50)
  customerInfo    Json?            @map("customer_info")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  packingSessions PackingSession[]

  @@unique([warehouseId, trackingCode], name: "uq_orders_warehouse_tracking")
  @@index([trackingCode])
  @@index([orderCode])
  @@map("orders")
}

model PackingSession {
  id                 String           @id @default(uuid()) @db.Uuid
  warehouseId        String           @map("warehouse_id") @db.Uuid
  orderId            String           @map("order_id") @db.Uuid
  stationId          String           @map("station_id") @db.Uuid
  cameraId           String           @map("camera_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  status             String           @default("WAITING") @db.VarChar(30)
  idempotencyKey     String?          @unique @map("idempotency_key") @db.VarChar(100)
  workerEpoch        String?          @map("worker_epoch") @db.Uuid
  version            Int              @default(1)
  startTime          DateTime         @default(now()) @map("start_time") @db.Timestamptz
  endTime            DateTime?        @map("end_time") @db.Timestamptz
  cancellationReason String?          @map("cancellation_reason") @db.Text
  hasPartialVideo    Boolean          @default(false) @map("has_partial_video")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  station            Station          @relation(fields: [stationId], references: [id], onDelete: Restrict)
  camera             Camera           @relation(fields: [cameraId], references: [id], onDelete: Restrict)
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  commands           PackingCommand[]
  video              Video?
  inboxEvents        WorkerEventsInbox[]

  @@index([stationId, status])
  @@index([warehouseId, createdAt])
  @@map("packing_sessions")
}

model PackingCommand {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String         @map("session_id") @db.Uuid
  stationId      String         @map("station_id") @db.Uuid
  commandType    String         @map("command_type") @db.VarChar(50)
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(100)
  workerEpoch    String?        @map("worker_epoch") @db.Uuid
  payload        Json
  payloadHash    String         @map("payload_hash") @db.VarChar(64)
  status         String         @default("PENDING") @db.VarChar(30)
  retryCount     Int            @default(0) @map("retry_count")
  errorMessage   String?        @map("error_message") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  dispatchedAt   DateTime?      @map("dispatched_at") @db.Timestamptz
  ackedAt        DateTime?      @map("acked_at") @db.Timestamptz
  executedAt     DateTime?      @map("executed_at") @db.Timestamptz

  session        PackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  station        Station        @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, status])
  @@map("packing_commands")
}

model WorkerEventsInbox {
  id             String          @id @default(uuid()) @db.Uuid
  eventId        String          @unique @map("event_id") @db.VarChar(100)
  workerId       String          @map("worker_id") @db.Uuid
  sessionId      String?         @map("session_id") @db.Uuid
  eventType      String          @map("event_type") @db.VarChar(50)
  sequenceNumber BigInt          @map("sequence_number")
  payload        Json
  processedAt    DateTime        @default(now()) @map("processed_at") @db.Timestamptz

  worker         Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  session        PackingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workerId, sequenceNumber])
  @@map("worker_events_inbox")
}

model Video {
  id               String         @id @default(uuid()) @db.Uuid
  packingSessionId String         @unique @map("packing_session_id") @db.Uuid
  filename         String         @db.VarChar(255)
  localPath        String         @map("local_path") @db.Text
  nasPath          String?        @map("nas_path") @db.Text
  duration         Decimal        @default(0.0) @db.Decimal(8, 2)
  fileSize         BigInt         @default(0) @map("file_size")
  sha256           String         @db.VarChar(64)
  thumbnailPath    String?        @map("thumbnail_path") @db.Text
  syncStatus       String         @default("LOCAL") @map("sync_status") @db.VarChar(30)
  syncAttempts     Int            @default(0) @map("sync_attempts")
  syncError        String?        @map("sync_error") @db.Text
  isPartial        Boolean        @default(false) @map("is_partial")
  isLocked         Boolean        @default(false) @map("is_locked")
  lockedBy         String?        @map("locked_by") @db.Uuid
  lockedAt         DateTime?      @map("locked_at") @db.Timestamptz
  lockReason       String?        @map("lock_reason") @db.Text
  disputeStatus    String         @default("NORMAL") @map("dispute_status") @db.VarChar(30)
  purgeStatus      String         @default("ACTIVE") @map("purge_status") @db.VarChar(30)
  purgedAt         DateTime?      @map("purged_at") @db.Timestamptz
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  packingSession   PackingSession @relation(fields: [packingSessionId], references: [id], onDelete: Cascade)
  locker           User?          @relation("VideoLockedBy", fields: [lockedBy], references: [id], onDelete: SetNull)

  @@index([syncStatus])
  @@index([isLocked, disputeStatus, purgeStatus])
  @@index([createdAt])
  @@map("videos")
}

model StorageConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  warehouseId        String    @map("warehouse_id") @db.Uuid
  storageType        String    @map("storage_type") @db.VarChar(50)
  path               String    @db.Text
  username           String?   @db.VarChar(100)
  passwordEncrypted  String?   @map("password_encrypted") @db.Text
  retentionDays      Int       @default(90) @map("retention_days")
  localRetentionDays Int       @default(14) @map("local_retention_days")
  enabled            Boolean   @default(true)
  isDefault          Boolean   @default(false) @map("is_default")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  warehouse          Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("storage_configs")
}

model SystemLog {
  id          BigInt     @id @default(autoincrement())
  businessId  String?    @map("business_id") @db.Uuid
  warehouseId String?    @map("warehouse_id") @db.Uuid
  level       String     @db.VarChar(20)
  module      String     @db.VarChar(50)
  message     String     @db.Text
  metadata    Json?
  userId      String?    @map("user_id") @db.Uuid
  stationId   String?    @map("station_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  business    Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  station     Station?   @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([module, level, createdAt])
  @@map("system_logs")
}
